# ---------------------------------------------------------------------------
# Server
# ---------------------------------------------------------------------------
PORT=3000
HEADLESS=false

# ---------------------------------------------------------------------------
# Concurrency
# POOL_SIZE browser tabs serve requests in parallel; each request is still
# serialised within its own tab. Requests beyond capacity wait, and past
# MAX_QUEUE the proxy returns 429 with Retry-After instead of queueing forever.
# Raising POOL_SIZE past what the upstream account tolerates trades throughput
# for rate limiting. GET /health reports live pool stats.
# ---------------------------------------------------------------------------
POOL_SIZE=3
MAX_QUEUE=32

# ---------------------------------------------------------------------------
# Browser session
# Export your ChatGPT cookies to this file. Keep it out of version control.
# ---------------------------------------------------------------------------
CHATGPT_COOKIES_PATH=src/cookies/chatgpt.com.cookies.json

# ---------------------------------------------------------------------------
# Client authentication (optional)
# Leave empty for a zero-config localhost setup. When set, clients must send
# the token as x-api-key, Authorization: Bearer <token>, or anthropic-auth-token.
# ---------------------------------------------------------------------------
ANTHROPIC_AUTH_TOKEN=

# ---------------------------------------------------------------------------
# Model routing for the Anthropic surface (/v1/messages)
# Claude clients send claude-opus-*, claude-sonnet-*, claude-3-5-haiku-*.
# Each class is routed to one of the backend models listed by GET /v1/models.
# ---------------------------------------------------------------------------
MODEL_OPUS=gpt-5-6-thinking
MODEL_SONNET=gpt-5.3
MODEL_HAIKU=gpt-5.3-nano

# ---------------------------------------------------------------------------
# Output shaping
# Replies are flattened to single-line plain text by default. Set both to
# false if a client needs markdown and code blocks preserved.
# ---------------------------------------------------------------------------
FLATTEN_OUTPUT=true
STRIP_MARKDOWN=true

# ---------------------------------------------------------------------------
# Tool-call guard
# Upstream has no native function calling, so tool compliance is prompt-based
# and imperfect. When enabled, each reply is checked for the two failure modes
# that break an agent loop — inventing a tool's result without calling it, and
# repeating a call whose <tool_result> is already in the transcript — and one
# corrective retry is issued. If the retry does not help, the original reply is
# returned rather than an error. Set TOOL_GUARD=false to disable.
# ---------------------------------------------------------------------------
TOOL_GUARD=true
TOOL_GUARD_MAX_RETRIES=1

# ---------------------------------------------------------------------------
# Optional integrations
# ---------------------------------------------------------------------------
BRAVE_API_KEY=
BRAVE_API_URL=
DEBUG=false
